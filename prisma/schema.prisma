generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}



model User {

  id        Int      @id @default(autoincrement())

  username  String   @unique

  password  String

  name      String?

  createdAt DateTime @default(now())

}




model Project {

  id        Int      @id @default(autoincrement())

  name      String

  desc      String

  image     String

  createdAt DateTime @default(now())

}